# macOS
.DS_Store

# Build artefact, regenerated by the zip step in any session that needs it.
gemevents-deploy.zip

# Local editor/agent state, not part of the project.
.claude/settings.local.json

# NOTE: index.html is deliberately NOT ignored. It is generated from
# gem-artifact.html by build.py, but it is also the exact artefact that gets
# deployed — committing it means the deployed build is always recoverable, and
# a future push-to-deploy needs no build step in CI.
